# This makes discovery files
# https://github.com/coreos/fleet/blob/master/Documentation/examples/service-discovery.md

<%= project_sha %>_app:
  image: grnds/<%= project %>_ci
  environment:
    SHA: <%= sha %>
    GITHUB_READ_TOKEN: <%= read_token %>
  links:
    - <%= project_sha %>_mysql

<%= project_sha %>_mysql:
  image: grnds/mysql
  ports:
    - :3306
