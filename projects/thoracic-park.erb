# This makes discovery files
# https://github.com/coreos/fleet/blob/master/Documentation/examples/service-discovery.md

<%= project_sha %>_app:
  image: grnds/<%= project %>_ci
  environment:
    SHA: <%= ENV["SHA"] %>
    GITHUB_READ_TOKEN: <%= ENV["GITHUB_READ_TOKEN"] %>
    AWS_ACCESS_KEY_ID: <%= ENV["AWS_ACCESS_KEY_ID"] %>
    AWS_SECRET_ACCESS_KEY: <%= ENV["AWS_SECRET_ACCESS_KEY"] %>
  links:
    - <%= project_sha %>_mysql

<%= project_sha %>_mysql:
  image: grnds/mysql
  ports:
    - :3306
