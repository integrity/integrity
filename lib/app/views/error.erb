<div class="error">
  <dl>
    <dt>Error:</dt>
    <dd>
      <strong><%= @error.message %></strong>
      <pre class="backtrace">
        <%= @error.backtrace.join("\n") %>
      </pre>
    </dd>
    <dd>
      <strong>Query parameters:</strong>
      <pre class="query_params">
        <%= params.inspect %>
      </pre>
    </dd>
    <dt>What can I do?</dt>
    <dd>
      - literally nothing
    </dd>
  </dl>
</div>
