<div class="table-responsive">
  <table class="table table-hover table-condensed" id="previous_stories">
    <thead>
      <tr>
        <th>ID</th>
        <th>Type</th>
        <th>Story Name</th>
        <th>Owner</th>
        <th>Age (days)</th>
      </tr>
    </thead>
    <tbody>
      <% stories.each do |story| %>
        <%= partial(:delivered_story_list_item, locals: {story: story}) %>
      <% end %>
    </tbody>
  </table>
</div>
