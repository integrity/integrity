          <li class="message-preview">
            <a href="<%= build_path(build) %>">
              <div class="media">
                <span class="pull-left"><i class="fa fa-<%= build_status(build).icon %> fa-3x"></i></span>
                <div class="media-body">
                  <h4 class="media-heading"><strong><%= build.name %></strong></h4>
                  <span class="small text-muted"><i class="fa fa-code-fork"></i> <%= build.branch.name %></span><br>
                  <span class="small text-muted"><i class="fa fa-user"></i> <%= build.author %></span><br>
                  <span class="small text-muted"><i class="fa fa-clock-o"></i> <%= time_ago_in_words(build.committed_at) %></span>
                  <p class="small text-muted">
                    <em><i class="fa fa-quote-left" style="margin-right:5px;"></i><%= h(build.full_message) %></em>
                  </p>
                </div>
              </div>
            </a>
          </li>
        <% end %>
        <li class="message-footer"><a href="/">Read All New Messages</a></li>
      </ul>
    </li>
