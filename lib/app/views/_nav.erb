        <a href="#" class="dropdown-toggle" data-toggle="dropdown"><i class="fa fa-th-large"></i> Project <b class="caret"></b></a>
        <ul class="dropdown-menu">
          <li><a href="<%= project_path(@project, :edit) %>"><i class="fa fa-fw fa-edit"></i> Edit</a></li>
          <li><a href="#"><i class="fa fa-fw fa-github-square"></i> Github</a></li>
          <li class="divider"></li>
          <li><a href="/logout"><i class="fa fa-fw fa-power-off"></i> Log Out</a></li>
        </ul>
      </li>
    <% else %>
      <li><a href="<%= path('new') %>" id="new"><i class="fa fa-fw fa-plus-circle"></i> Add Project</a></li>
    <% end  %>
