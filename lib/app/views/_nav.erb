                  <span class="small text-muted"><i class="fa fa-clock-o"></i> <%= time_ago_in_words(build.committed_at) %></span>
                  <p class="small text-muted">
                    <em><i class="fa fa-quote-left" style="margin-right:5px;"></i><%= h(build.full_message) %></em>
                  </p>
                </div>
              </div>
            </a>
          </li>
        <% end %>
        <li class="message-footer"><a href="/">Read All New Messages</a></li>
      </ul>
