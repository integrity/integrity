<a class="pill label label-<%= status.color %>" href="<%= project_path(project) %>">
  <% if build && [:failed].include?(build.status) %>
    <i class="fa fa-fire-extinguisher fa-3x"></i>
  <% end %>
  <%= project.name %>
  <% if build && [:failed].include?(build.status) %>
    <span>
      <%= build.author %>
    </span>
  <% end %>
</a>
