<a class="pill label label-<%= build_status(build).color %>" href="<%= project_path(project) %>">
  <% if build && [:failed].include?(build.status) %>
    <i class="fa fa-fire-extinguisher fa-3x"></i>
  <% end %>
  <span>
    <%= project.name %>
  </span>
  <% if build && [:failed].include?(build.status) %>
    <small>
      <%= build.author %>
    </small>
  <% end %>
</a>
