<%= partial(:auto_reload) %>

<% if @branch.blank? %>

  <h3 class="text-center short"><%= "No Builds for #{@branch.name}" %></h3>
  <form action="<%= project_path(@project, :builds) %>" class="blank_slate" method="<%= :post %>">
    <button type="<%= :submit %>">Build HEAD</button>
  </form>

<% else %>

  <div class="row" id="projects">
    <% @latest_builds.each do |build|
      status = branch_status(build) %>
      <%= partial(:build, locals: {branch: @branch, build: build, project: @project, status: status}) %>
    <% end %>
  </div>

  <div class="row" id="builds">
    <% if @running.any? %>
      <h3 class="text-center short"><%= "#{@running.count} Running Build#{@running.count == 1 ? '' : 's'}" %></h3>
      <%= partial(:build_list, locals: {builds: @running}) if @running.any? %>
    <% end %>
    <% if @pending.any? %>
      <h3 class="text-center short"><%= "#{@pending.count} Pending Build#{@running.count == 1 ? '' : 's'}" %></h3>
      <%= partial(:build_list, locals: {builds: @pending}) if @pending.any? %>
    <% end %>
    <h3 class="text-center short">Completed Builds</h3>
    <%= partial(:build_list, locals: {builds: @completed}) if @completed.any? %>
  </div>

<% end %>
