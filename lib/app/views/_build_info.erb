<div class="col-sm-12">

  <div class="row">
    <div class="col-sm-8">
      <h1>
        <%= build.human_status %>
        <% if build.building? %>
          <% if build.human_time_since_start.present? %>
            <%= "for #{build.human_time_since_start}" %>
          <% end %>
        <% elsif build.finished? %>
          <%= "in #{build.human_duration}" %>
        <% end %>
      </h1>
      <h3>
      <%= h(build.full_message).gsub("\n", '<br />') %>
      </h3>
      <% if build.kill_reason %>
        <p><%= build.kill_reason %></p>
      <% end %>
      <% unless build.fail_category.empty? %>
        <p>Failed Category: <%= build.fail_category %></p>
      <% end %>
      <h4>
        <span class="label label-<%= build_service(build)[:color] if build_service(build) %>">
          <i class="fa fa-<%= build_service(build)[:icon] if build_service(build) %>" > </i>
          <%= build.service_template %>
        </span>
      </h4>

    </div>
    <div class="col-sm-4">
      <% unless build.building? %>
        <form action="<%= build_path(build) %>" method="post" class="submit">
          <input name="_method" type="hidden" value="delete"/>
          <button class="btn btn-danger" title="Delete Build">
            Delete
          </button>
        </form>
      <% end %>

      <% if build.pending? or build.building? %>
        <form action="<%= build_path(build, :cancel) %>" method="post" class="submit">
          <button class="btn btn-danger" title="Cancel Build">
            Cancel
          </button>
        </form>
      <% end %>

      <% if build.completed? or build.service_template != 'spec' %>
        <form action="<%= build_path(build) %>" method="post" class="submit">
          <button class="btn btn-default" title='Run Specs' type='submit'>
            <img src="/images/cats.png" height="20em">
            Run Specs
          </button>
        </form>
      <% end %>

    </div>
  </div>

  <br>
  <div class="row">
      <%= partial(:build_list, locals: {builds: [build]}) %>
  </div>

  <div class="row">
    <div class="col-sm-12">
      <% if build.building? || build.completed? %>
        <% if ! build.project.artifacts_empty? && !(files = artifact_files(build)).empty? %>
          <h2>
            Artifacts
            <blockquote>
              <ul id="artifacts">
                <% files.each do |file| %>
                  <a title="<%= file[:relative_path] %>" href="<%= file[:url] %>"><%= file[:name] %></a>
                  <br>
                <% end %>
              </ul>
            </blockquote>
          </h2>
        <% end %>
      <% end %>

      <% if build.completed? || build.in_progress? %>
        <iframe style="margin:10px 30px 10px 10px" width="98%" height="600" seamless="seamless" src="<%= link_to_logs(build) %>"></iframe>
      <% end %>
    </div>
  </div>

  <div class="row">
    <div class="col-md-12">
      <h2> Build Details </h2>
      <table class="table" id="previous_builds">
        <thead>
          <tr>
            <th>successful?</th>
            <th>started_at</th>
            <th>completed_at</th>
            <th>updated_at</th>
            <th>state</th>
            <th>status</th>
            <th>fleetctl_status</th>
            <th>machine_ip</th>
            <th>public_port</th>
          </tr>
        </thead>
        <tbody>
          <td><%= build.successful %></td>
          <td><%= build.started_at %></td>
          <td><%= build.completed_at %></td>
          <td><%= build.updated_at %></td>
          <td><%= build.state %></td>
          <td><%= build.status %></td>
          <td><%= build.fleetctl_status %></td>
          <td><%= build.machine_ip %></td>
          <td><%= build.public_port %></td>
        </tbody>
      </table>
    </div>
  </div>

  <% if build.building? %>
    <div class="row">
      <div class="col-md-12">
        <h2> Enter Into this container </h2>
        <ul>
          <% build.enter_instructions.each do |step| %>
            <li><%= step %></li>
            <% end %>
        </ul>
      </div>
    </div>
  <% end %>

  <div class="row col-md-6">
    <h2> Report Build Problems </h2>
    <form action="<%= build_path(build, :fail_reason) %>" method="post" id="fail_reason_form" class="form-horizontal alert alert-danger">
      <fieldset>
        <div class="form-group">
          <label class="col-sm-4 control-label">Did the build process fail?  If so, what happened?</label>
          <div class="col-sm-6">
              <select class="form-control" form="fail_reason_form" name="fail_reason">
                  <option value="rspec-heisen">Heisen Spec</option>
                  <option value="ruby-gems">Gem Installation Failure</option>
                  <option value="ruby-db">Database Failure</option>
                  <option value="bash">Other Bash Process Failure</option>
                  <option value="delayed_job-stayed-at-pending">Never Started (stayed at pending)</option>
                  <option value="no-output">No Logging Output</option>
                  <option value="coreos-multiple-times">Built multiple times</option>
                  <option value="coreos-stalled">CoreOS Stall</option>
                  <option value="coreos-other">CoreOS Failure (other)</option>
                  <option value="other">Other</option>
                  <option value="">None</option>
              </select>
          </div>
          <div class="col-sm-2">
            <button class="btn btn-default" title='Update Error' type='submit'>
              Submit
            </button>
          </div>
        </div>
      </fieldset>
    </form>
  </div>

</div>
