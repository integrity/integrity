<section class="container">
  <div class="container-page">
    <div class="col-md-12">
      <h3 class="dark-grey">Create New Project:</h3>
      <form action="<%= root_path %>" method="post" role="form">
        <%= partial(:project_form, locals: {project: @project}) %>
        <button class="btn btn-default" type="submit">Create Project</button>
      </form>
    </div>
  </div>
</section>