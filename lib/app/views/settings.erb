<section class="container">
<div class="container-page">
  <div class="row" style="margin-bottom: 1em;">
    <div class="col-md-4">
      <h3 style="text-align: center">Builds</h3>
      <div id="builds-donut"></div>
    </div>
    <div class="col-md-8">
      <h3 style="text-align: center">Load Utilization</h3>
      <div id="load-area"></div>
    </div>
  </div>
  <div class="row">
    <div class="col-md-12">
      <h3>Machines</h3>
      <ul>
      <% @load_utilization.machines.each do |machine| %>
        <li> <%= machine %> </li>
      <% end %>
      </ul>
    </div>
  </div>
    <div class="row">
      <div class="col-md-12">
        <h3>Load Utilization</h3>
          <table class="table table-hover table-condensed" id="previous_builds">
            <thead>
              <tr>
                <th>Pending Builds</th>
                <th>Pending Load</th>
                <th>Running Builds</th>
                <th>Running Load</th>
                <th>Total Load Need</th>
                <th>Machine Count</th>
                <th>Load Capacity</th>
                <th>Load Deficit</th>
                <th>New Machines Required</th>
                <th>Max Running Builds</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><%= @load_utilization.pending_builds %></td>
                <td><%= @load_utilization.pending_load %></td>
                <td><%= @load_utilization.running_builds %></td>
                <td><%= @load_utilization.running_load %></td>
                <td><%= @load_utilization.load_requirement %></td>
                <td><%= @load_utilization.active_machines %></td>
                <td><%= @load_utilization.load_capacity %></td>
                <td><%= @load_utilization.load_deficit %></td>
                <td><%= @load_utilization.machines_required %></td>
                <td><%= @load_utilization.max_running_builds %></td>
              </tr>
            </tbody>
          </table>
    </div>
  </div>
</div>
</section>
