tr class=stack_state_row_color_class(stack)
  td
    .mono
      b = stack.state.upcase
      div: small: i = "updated #{time_ago_in_words(stack.state_updated_at)}"
    .actions
      - if view
        div
          == link_to 'view', "/pancakes/stacks/#{stack.sha}", class: 'btn btn-link btn-lg'
      div
        a.btn.btn-sm.btn-danger href="/pancakes/stacks/#{stack.sha}/bring_down" Bring down
      div
        a.btn.btn-sm.btn-danger href="/pancakes/stacks/#{stack.sha}/destroy" class=(stack.off? ? '' : 'disabled')
          | Delete
          br
          small
            | (must be OFF)
      div
        a.btn.btn-sm.btn-warning href="/pancakes/stacks/#{stack.sha}/refresh"  Refresh state
      div
        a.btn.btn-sm.btn-primary href="/pancakes/stacks/#{stack.sha}/restart_with_heads"
          | Restart
          br
          small
            | (branch heads)
      div
        a.btn.btn-sm.btn-primary href="/pancakes/stacks/#{stack.sha}/restart_same_commits"
          | Restart
          br
          small
            | (same commits)
  td.mono.nowrap
    div
      b> sha:
      = stack.short_sha
    div
      b> id:
      = stack.id
    div
      b> uptime:
      = uptime(stack)
  td.services
    table.table.commits
      tbody
        - stack.commits.each do |commit|
          tr
            td
              a.btn.btn-xs.btn-primary.toggle-lock-btn href="/pancakes/stacks/#{stack.sha}/#{commit.codebase}/toggle_lock"
                - if commit.locked?
                  | unlock
                - else
                  | lock
            td
              div == service_link(commit)
              .mono = tcp_string(commit)
            td.mono = commit.short_sha
            td.branch-name.mono.nowrap = commit.branch
            td.nowrap = time_ago_in_words(commit.date_as_date) + ' ago'
            td.nowrap = commit.author
            td.commit-message = commit.message
        - if stack.units.with_service_name(:mailcatcher)
          tr
            td
            td(colspan='5') = mailcatcher_str(stack.units.with_service_name(:mailcatcher))
            td
        - if stack.units.with_service_name(:mysql)
          tr
            td
            td.mono(colspan='5') == mysql_str(stack.units.with_service_name(:mysql))
            td
