tr class=human_state_row_color_class(stack)
  td
    .mono
      b = stack.human_state.upcase
      div: small: i = "updated #{time_ago_in_words(stack.state_updated_at)}"
    .actions
      - if view
        div
          == link_to 'view', "/pancakes/stacks/#{stack.id}", class: 'btn btn-link btn-lg'
      div
        a.btn.btn-sm.btn-danger href="/pancakes/stacks/#{stack.id}/bring_down" Bring down
      div
        a.btn.btn-sm.btn-danger href="/pancakes/stacks/#{stack.id}/destroy" class=(stack.off? ? '' : 'disabled')
          | Delete
          br
          small
            | (must be OFF)
      div
        a.btn.btn-sm.btn-warning href="/pancakes/stacks/#{stack.id}/refresh"  Refresh state
      div
        a.btn.btn-sm.btn-primary href="/pancakes/stacks/#{stack.id}/restart_with_branch_heads"
          | Restart
          br
          small
            | (branch heads)
      div
        a.btn.btn-sm.btn-primary href="/pancakes/stacks/#{stack.id}/restart_with_same_commits"
          | Restart
          br
          small
            | (same commits)
  td.mono.nowrap
    div
      b> sha:
      = stack.short_sha
    div
      b> id:
      = stack.id
    div
      b> uptime:
      = uptime(stack)
  td.services
    table.table.commits
      tbody
        - stack.commits.each do |commit|
          tr
            td
              - if commit.codebase == 'jarvis'
                == service_link(commit)
              - else
                b = commit.codebase
            td.lock-controls
              span.fa> class=(commit.locked? ? 'fa-lock' : 'fa-unlock')
              a.btn.btn-xs.btn-default.toggle-lock-btn href="/pancakes/stacks/#{stack.id}/#{commit.codebase}/toggle_lock"
                - if commit.locked?
                  | unlock
                - else
                  | lock
            td.mono = tcp_string(commit)
            td.commit-info
              span.mono = commit.short_sha
              span.branch-name.mono.nowrap = commit.branch
              span.nowrap = time_ago_in_words(commit.date) + ' ago'
              span.nowrap = commit.author
              div.commit-message = commit.message
        - if stack.unit_with_service_name(:mailcatcher)
          tr
            td(colspan='5') == mailcatcher_str(stack.unit_with_service_name(:mailcatcher))
        - if stack.unit_with_service_name(:mysql)
          tr
            td.mono(colspan='5') == mysql_str(stack.unit_with_service_name(:mysql))
