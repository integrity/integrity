.pancakes
  div
    - if flash[:error]
      br
      .alert.alert-danger.alert-dismissible = flash[:error]

    - if flash[:notice]
      br
      .alert.alert-info.alert-dismissible = flash[:notice]

  form.form#stacks-form action='/pancakes/stacks' method='post'
    h3
      | New Stack
      br
      small Start typing to autocomplete your branch
      br
      small.mono branch/commit formats: SHA | SHA:L(+|-)BRANCH | L(+|-)BRANCH branches are locked if left empty

    .branch-inputs
      - services_for_form.each do |codebase|
        .form-group
          label for="#{codebase}_branch" #{codebase} branch
          input.form-control type='text' name='[branches][#{codebase}]' id="#{codebase}_branch" placeholder='master' autocomplete='off'
      .form-group
        label for="pocs" Points Of Contact
        input.form-control type='text' name='pocs' id="pocs" autocomplete='off' placeholder='Rita, Jerry Garcia, Elmo'
        p.help-block Stacks with out a POC may be deleted without notice!!!
      button.btn.btn-primary type='submit' Create stack

  h3 Stacks

  .row
    .col-xs-12
      table.table.table-bordered.table-hover.stacks-list
        thead
          tr
            th Health
            th Name
            th POCs
            th Status Message
        tbody
          - @stacks.map{|stack| [stack, stack.last_health_check] }.each do |stack,last_health_check|
            tr class=event_bootstrap_class(last_health_check)
              td.col-xs-1
                = event_status(last_health_check)
              td.col-xs-1
                == link_to stack.name, "/pancakes/stacks/#{stack.id}"
              td.col-xs-2
                = poc_string(stack.pocs)
              td.col-xs-8
                = last_health_check.status_message
