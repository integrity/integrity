tr.pancakes-item class=pancakes_state_bootstrap_class(stack)
  td.status.mono
    = stack.state_of_the_pancakes.to_s.upcase

  td.mono.small = stack.branch_id.to_s + " no" + stack.serialno.to_s
  td = time_ago_in_words(pacific_time(stack.start_time_as_date)).sub(' ago', '')
  td
    == slim :"pancakes/_urls", layout: false, locals: { stack: stack }

  td.actions
    a.btn.btn-danger  href="/pancakes/#{stack.branch_id}/#{stack.serialno_str}/destroy" Destroy
