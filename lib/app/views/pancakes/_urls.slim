- if stack.tcp_info
  table.urls
    tbody
      - %i[jarvis frick tim].each do |codebase|
        - commit = stack.commit_for(codebase)
        tr
          td
            a.btn.btn-primary.flip-lock-btn href="/pancakes/#{stack.branch_id}/#{stack.serialno_str}/#{codebase}/flip_lock"
              - if commit.locked?
                | unlock
              - else
                | lock
          td == link_to codebase, stack.service_url("#{codebase}-server"), target: '_blank'
          td.mono.small == link_to commit.sha[0..6], github_commit_url(commit.sha), target: '_blank'
          td.mono.small = commit.branch_name
          td.small = time_ago_in_words pacific_time(commit.date_as_date)
          td.small = commit.author_name
          td.small = commit.message
      tr
        td
        td(colspan='5') == link_to 'mailcatcher', stack.service_url(:mailcatcher), target: '_blank'
        td
      tr
        td
        td.mono.small(colspan='5') = "mysql -u root -h #{stack.tcp_info(:mysql)[:host]} -P #{stack.tcp_info(:mysql)[:port]}"
        td
