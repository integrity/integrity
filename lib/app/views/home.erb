<% if @projects.empty? %>
  <div class="blank_slate">
    <p>None yet, huh?</p>
    <h1>
      Why don't you
      <%#= succeed '?' do %>
        <a href="<%= path('new') %>">create your first project</a>
        <% if show_login? %>
          or
          <a href="<%= path('login') %>" id="login">login</a>
        <% end %>
      <%# end %>
    </h1>
  </div>
<% else %>
  <ul id="projects">

    <% @projects.each do |project| %>
      <%= partial(:project, locals: {project: project}) %>
    <% end %>

  </ul>


  <!--<p>-->
    <!--<a href="<%= path('new') %>" id="new">Add a new project</a>-->
    <!--<% if show_login? %>-->
      <!--or-->
      <!--<a href="<%= path('login') %>" id="login">Login</a>-->
    <!--<% end %>-->
  <!--</p>-->
<% end %>