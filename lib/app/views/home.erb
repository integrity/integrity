<% if @projects.empty? %>
  <div class="blank_slate">
    <p>None yet, huh?</p>
    <h1>
      Why don't you
      <%#= succeed '?' do %>
        <a href="<%= path('new') %>">create your first project</a>
        <% if show_login? %>
          or
          <a href="<%= path('login') %>" id="login">login</a>
        <% end %>
      <%# end %>
    </h1>
  </div>
<% else %>
  <div class="row" id="projects">
    <% @projects.each do |project|
      status = project_status(project)
      build = project.last_build %>
      <%= partial(:project, locals: {project: project, build: build, status: status}) %>
    <% end %>
  </div>
  <div class="row" id="builds">
    <%= partial(:build_list, locals: {builds: @builds}) %>
  </div>
<% end %>