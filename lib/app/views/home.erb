<%= partial(:auto_reload) %>

<% if @projects.empty? %>
  <div class="blank_slate">
    <p>None yet, huh?</p>
    <h1>
      Why don't you
      <%#= succeed '?' do %>
        <a href="<%= path('new') %>">create your first project</a>
        <% if show_login? %>
          or
          <a href="<%= path('login') %>" id="login">login</a>
        <% end %>
      <%# end %>
    </h1>
  </div>
<% else %>
  <div class="row" id="projects">
    <div class="col-xs-12">
      <% @projects.each do |project,latest_master_build| %>
        <%= partial(:project, locals: {project: project, build: latest_master_build}) %>
      <% end %>
    </div>
  </div>
  <div class="row" id="builds">
    <% if @running.any? %>
      <h3 class="text-center short"><%= "#{@running.count} Running Build#{@running.count == 1 ? '' : 's'}" %></h3>
      <%= partial(:build_list, locals: {builds: @running}) if @running.any? %>
    <% end %>
    <% if @pending.any? %>
      <h3 class="text-center short"><%= "#{@pending.count} Pending Build#{@running.count == 1 ? '' : 's'}" %></h3>
      <%= partial(:build_list, locals: {builds: @pending}) if @pending.any? %>
    <% end %>
    <h3 class="text-center short">Current Stories</h3>
    <%= partial(:story_list, locals: {stories: @stories_in_flight}) if @stories_in_flight.any? %>
    <h3 class="text-center short">Completed Builds</h3>
    <%= partial(:build_list, locals: {builds: @completed}) if @completed.any? %>
  </div>
<% end %>
