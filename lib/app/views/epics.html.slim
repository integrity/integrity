.row#epics
  h2.text-center.short Off da Ranch
  <% off_da_ranch = @report.delete(:off_da_ranch) %>
  ul.off-da-ranch
  - off_da_ranch.each do |user|
    li = user
  h2.text-center.short Epics
  ul.epics
  - @report.keys.each do |epic| 
    .epic-block
    li.epic = epic
      ul.users
        - @report[epic].keys.each do |user| 
          li.user = user
	  ul.stories
            - @report[epic][user].each do |
              li.story."<% story.current_state %>"