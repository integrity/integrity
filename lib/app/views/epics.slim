- off_da_ranch = @report.delete(:off_da_ranch)
- story_counts = @report.delete(:story_counts)
- non_epic_stories = @report.delete(:story_counts)
- sorted_report = {NES: non_epic_stories}.merge!(@report.sort.to_h)

.row#epics
  h2.text-center.short Epics
  ul.epics
    - sorted_report.keys.each do |epic|
      .epic-block
        li.epic = epic.to_s
        li.requestors = sorted_report[epic.to_sym][:requestors].join(', ') if sorted_report[epic.to_sym][:requestors].kind_of?(Array)
        li.user-list
          ul.users
            - sorted_report[epic.to_sym][:developers].keys.each do |user|
              li.user = user.to_s
              li.stories_list
                ul.stories
                  - sorted_report[epic.to_sym][:developers][user.to_sym].each do |story|
                    a href="#{story.url}" title="#{story.name}" target="_blank" data-age="#{story.age_seconds}"
                      i class="#{story.display_class}"
.row
  h2.text-center.short NES Work
  .progress
    .progress-bar.progress-bar-success style="width: #{@nes_report[:nes_percent]}%"
    .progress-bar.progress-bar-info style="width: #{@nes_report[:es_percent]}%"
  .ul
    .li
      | Total Stories #{@nes_report[:stories_count]}
    .li
      | NES Percentage #{@nes_report[:nes_percent]}
.row
  .col-md-6
    h2.text-center.short Unassigned Engineers
    ul.off-da-ranch
    - off_da_ranch.each do |user|
      li = user
  .col-md-6
    h2.text-center.short Stories
    ul.stories
      li
        i class='f fa fa-cogs'
          |  Started #{story_counts[:started]}
      li
        i class='fa fa-code-fork'
          |  Finished #{story_counts[:finished]}
      li
        i class='fa fa-gavel'
          |  Delivered #{story_counts[:delivered]}
