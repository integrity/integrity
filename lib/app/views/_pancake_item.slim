tr.pancakes-item class=pancakes_state_bootstrap_class(pancakes)
  td.status.mono
    - if branch.pancakes_locked?
      i.fa.fa-lock
    = pancakes.state_of_the_pancakes.to_s.upcase

  td = branch.id.to_s + " no" + branch.pancakes_serialno.to_s
  td = branch.project.name
  td
    == slim :_pancake_urls, layout: false, locals: { urls_hash: pancakes.urls, pancakes: pancakes }

  td.actions
    a.btn.btn-default href="/pancakes/#{branch.id}/flip_lock" #{branch.pancakes_locked? ? 'Unlock' : 'Lock'}
    a.btn.btn-danger  href="/pancakes/#{branch.id}/destroy" Destroy
