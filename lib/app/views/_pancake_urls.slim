- if urls_hash
  table.urls
    tbody
      - %i[jarvis frick tim].each do |codebase|
        tr
          td == link_to codebase, urls_hash["#{codebase}-server".to_sym], target: '_blank'
          td.mono.small == link_to pancakes.sha_for(codebase)[0..6], github_commit_url(pancakes.commit_for(codebase).sha), target: '_blank'
          td.mono.small = pancakes.branch_name_for(codebase)
          td.small = time_ago_in_words pacific_time(pancakes.commit_for(codebase).date)
          td.small = pancakes.commit_for(codebase).author_name
          td.small = pancakes.commit_for(codebase).message
      tr
        td == link_to 'mailcatcher', urls_hash[:mailcatcher], target: '_blank'
        td
        td
        td
        td
        td
