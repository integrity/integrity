
<% if build %>
<% status = build_status(build) %>
  <tr class="<%= build.bootstrap_class %>">
    <td class="status"><i class="fa fa-<%= status.icon %>"></td>

    <%#<td class="service">%>
      <%#<% if build.public_link %>%>
        <%#<%= "#{link_to %Q{<i class="fa fa-#{build_service(build)[:icon] if build_service(build)}"></i>}, build.public_link}" %>%>
      <%#<% else %>%>
        <%#<i class="fa fa-<%= build_service(build)[:icon] if build_service(build) %>">%>
      <%#<% end %>%>
    <%#</td>%>

    <td><%= link_to "#{build.project.try(:name)}", project_path(build.project)%></td>
    <td><%= link_to build.id, build_path(build) %></td>
    <td><a href="<%= build_path(build)%>"><%= build.sha1_short %></td>
    <td class="attribution"><%= build.author %></td>
    <td class="branch-name">
      <%= "#{build.branch.try(:name)}"%>
    </td>
    <td class="commit-message">
      <%= "#{build.try(:commit).try(:message)}"%>
    </td>
    <td><%= pacific_time(build.created_at).try(:strftime, '%R') %></td>
    <td><%= pacific_time(build.started_at).try(:strftime, '%R') %></td>
    <td><%= pacific_time(build.completed_at).try(:strftime, '%R') %></td>

    <td>
      <% if build.building? %>
        <%= Time.at(build.time_since_start).gmtime.strftime('%R:%S') %>
      <% elsif build.completed? and build.duration  %>
        <%= Time.at(build.duration).gmtime.strftime('%R:%S') %>
      <% end %>
    </td>

    <td><%= pacific_time(build.created_at).try(:strftime, '%m/%d') %></td>
    <td>
    <%= "#{link_to '<i class="fa fa-list"></i>', link_to_logs(build), target: '_blank'}"%>
    </td>
    <td>
    <%= "#{link_to '<i class="fa fa-github-alt"></i>', github_commit_url(build), target: '_blank'}" %>
    <%= "#{link_to '<i class="fa fa-columns"></i>', link_to_tracker(build), target: '_blank'}" if link_to_tracker(build) %>
    </td>
  </tr>
  <% end %>
