<% status = build_status(build) %>
<li class="<%= build.status %>">
  <a href="<%= build_path(build) %>">
    <span style="font-size: 5px;"><i class="fa fa-<%= status.icon %> fa-5x"></i></span>
    <strong class="build">
      <%= "#{build.project.try(:permalink)}:#{build.branch.try(:name) || 'master'} (#{build.sha1_short})" %>
    </strong>
    <span class="attribution">
      <%= "by #{build.author}, #{time_ago_in_words(build.committed_at, true)}" %>
    </span>
  </a>
</li>