<% if story %>
<% build = story.latest_build %>
  <tr class="<%= build.bootstrap_class if build %>">
    <td><a href="<%= story.url %>" target="_blank"><%= story.id %></td>
    <td>
      <% if build %>
        <a href="<%= build_path(build) %>"><%= build.sha1_short %>
      <% end %>
    </td>
    <td><%= story.project_name %></td>
    <td><%= story.type %></td>
    <td><%= story.name %></td>
    <td><%= story.followers %></td>
    <td><%= story.current_state %></td>
    <td><%= story.age %></td>
    <td>
      <% if story.branch_name %>
        <a class='copy-branch-name' data-branch-name="<%= story.branch_name %>" href="" data-container="body" data-toggle="popover" data-placement="bottom" data-content="<%= story.branch_name %> Copied!" tabindex="0">Copy</a>
      <% end %>
    </tp>
    <td>
      <% if story.create_pr_url %>
        <a href="<%= story.create_pr_url %>" target="_blank">Make Request
      <% end %>
    </td>
    <td>
      <% if story.pr_url %>
        <a href="<%= story.pr_url %>" target="_blank">View Request
      <% end %>
    </td>
  </tr>
<% end %>
