<% if story %>
<% build = story.latest_build %>
  <tr class="<%= build.bootstrap_class if build %>">
    <td><a href="<%= story.url %>" target="_blank"><%= story.id %></td>
    <td>
      <% if build %>
        <a href="<%= build_path(build) %>"><%= build.sha1_short %>
      <% end %>
    </td>
    <td><%= story.type %></td>
    <td><%= story.name %></td>
    <td><%= story.followers %></td>
    <td><%= story.current_state %></td>
    <td><%= story.commit_state %></td>
    <td><%= story.age %></td>
    <td><%= story.pr_url %></td>
  </tr>
  <% end %>
