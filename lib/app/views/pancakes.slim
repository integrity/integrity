/javascript:
  /= partial(:auto_reload)

- if !@pancaked_branches.empty?
  .row#active_diligence_branches
    h3.text-center.short
      = "#{@pancaked_branches.size} Pancakes"
      div: small: i
        |  Locked means a branch will not get updated when a new commit is pushed, although the branch will show the more recent commit.
        |  Destroying a stack will also stop tracking.
        |  Unlocking will not update the branch, branches will only update after a github push.
    table.table.table-hover.table-condensed#previous_builds
      thead
        tr
          th Status
          th ID
          /th Build
          th Tracking
          /th Branch
          /th SHA
          /th Commit Time
          /th Author
          /th Message
          th Services
          th
      tbody
        - @pancaked_branches.each do |branch|
          - next unless branch.pancakes
          == slim :_pancake_item, layout: false, locals: { branch: branch, pancakes: branch.pancakes }

- if !@not_pancaked_branches.empty?
  .row#branches
    h3.text-center.short
      = "#{@not_pancaked_branches.size} Recent Branch#{@not_pancaked_branches.size == 1 ? '' : 'es'}"
      div: small: i
        |  Services other than jarvis will try to use a branch
        |  of the same name as the jarvis branch, and otherwise master.
    .table-responsive
      table.table.table-hover.table-condensed#previous_builds
        thead
          tr
            th Spec Status
            th Project
            th Branch
            th Last Build
            th Commit Time
            th Author
            th SHA
            th Message
            th
        tbody
          - @not_pancaked_branches.each do |branch|
            tr class=branch.last_build.try(:bootstrap_class)
              td.status
                i class="fa fa-#{branch_status(branch).icon}"
              td = branch.project.name
              td = branch.name
              td == branch.last_build ? link_to(branch.last_build_id, build_path(branch.last_build)) : nil
              td = branch.last_build ? time_ago_in_words(branch.last_build.committed_at) : nil
              td = branch.last_build.try(:author)
              td == branch.last_build ? link_to(branch.last_build.sha1_short, github_commit_url(branch.last_build)) : nil
              td = branch.last_build.try(:message)
              td.actions
                - if !branch.pancaked?
                  a.btn.btn-success.start-tracking-btn href="/pancakes/#{branch.id}/start_tracking" Start Tracking
