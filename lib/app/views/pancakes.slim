form#create-pancakes-form action='/pancakes/create' method='post'
  - if @error
    div.alert.alert-danger.alert-dismissible = @error
  - %w[jarvis frick tim].each do |codebase|
    div.ui-widget
      label for="#{codebase}_branch" #{codebase} branch
      input type='text' name='#{codebase}-branch' id="#{codebase}_branch" autocomplete='off' placeholder='master'
  input type='submit' value='Make Pancakes'

.row#active_diligence_branches
  h3.text-center.short
    = "#{@stacks.size} Stacks of Pancakes"
    - if @stacks.size > 0
      div: small: i
        |  Locked means a stack will not get updated when a new commit is pushed to one of it's unlocked services.
        |  Destroying a stack will also stop tracking.
        |  Unlocking will not update the stack.
        |   They will only update after a github push.
  - if @stacks.size > 0
    table.table.table-hover.table-condensed#previous_builds
      thead
        tr
          th Status
          th ID
          th Uptime
          th Services
          th
      tbody
        - @stacks.each do |stack|
          == slim :"pancakes/_stack", layout: false, locals: { stack: stack }
