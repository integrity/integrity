<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="">
  <meta name="author" content="">

  <title>Honesty CI</title>

  <link href="favicon.ico" rel="shortcut icon" type="image/vnd.microsoft.icon" />

  <!-- Bootstrap Core CSS -->
  <link href="/css/bootstrap.css" rel="stylesheet">

  <!-- Custom CSS -->
  <!--<link href="css/reset.css" rel="stylesheet">-->
  <!--<link href="css/buttons.css" rel="stylesheet">-->
  <link href="/css/layout.css" rel="stylesheet">
  <link href="/css/honesty.css" rel="stylesheet">
  <link href="/css/morris.css" rel="stylesheet">

  <!-- Custom Fonts -->
  <link href="/css/font-awesome-4.1.0/css/font-awesome.min.css" rel="stylesheet" type="text/css">
  <link href="http://fonts.googleapis.com/css?family=Orbitron" rel="stylesheet">
  <link href="http://fonts.googleapis.com/css?family=Open+Sans" rel="stylesheet">
  <link href="http://fonts.googleapis.com/css?family=Droid+Sans+Mono" rel="stylesheet">

  <!-- HTML5 Shim and Respond.js IE8 support of HTML5 elements and media queries -->
  <!-- WARNING: Respond.js doesn't work if you view the page via file:// -->
  <!--[if lt IE 9]>
    <script src="https://oss.maxcdn.com/libs/html5shiv/3.7.0/html5shiv.js"></script>
    <script src="https://oss.maxcdn.com/libs/respond.js/1.4.2/respond.min.js"></script>
  <![endif]-->
</head>
<body>
  <div id="wrapper">
    <%= partial :nav %>
    <div id="page-wrapper">
      <div class="container-fluid">
        <%= partial :notice %>
        <%= yield %>
      </div><!-- /.container-fluid -->
    </div><!-- /#page-wrapper -->
  </div><!-- /#wrapper -->

  <script src="/js/jquery-1.11.0.js"></script>
  <script src="/js/bootstrap.js"></script>
  <!-- Morris Charts JavaScript -->
  <script src="/js/morris/raphael.min.js"></script>
  <script src="/js/morris/morris.js"></script>
  <script>
    if ($('#builds-donut').length != 0) {
      Morris.Donut({
        element: 'builds-donut',
        data: [
          {label: "Running", value: <%= Integrity::Build.running.count %> },
          {label: "Pending", value: <%= Integrity::Build.pending.count %> }
        ],
        resize: true
      });
      Morris.Area({
        element: 'load-area',
        data: [
          {period: '2014-01-22 00:00', running: 2, pending: 1, machines: 1},
          {period: '2014-01-22 01:00', running: 1, pending: 2, machines: 1},
          {period: '2014-01-22 02:00', running: 1, pending: 1, machines: 1},
          {period: '2014-01-22 03:00', running: 2, pending: 4, machines: 1},
          {period: '2014-01-22 04:00', running: 3, pending: 1, machines: 2},
          {period: '2014-01-22 05:00', running: 1, pending: 1, machines: 2},
          {period: '2014-01-22 06:00', running: 1, pending: 2, machines: 1},
          {period: '2014-01-22 07:00', running: 1, pending: 1, machines: 1},
          {period: '2014-01-22 08:00', running: 2, pending: 1, machines: 1},
          {period: '2014-01-22 09:00', running: 2, pending: 2, machines: 1},
          {period: '2014-01-22 10:00', running: 1, pending: 1, machines: 1},
          {period: '2014-01-22 11:00', running: 2, pending: 1, machines: 1},
          {period: '2014-01-22 12:00', running: 2, pending: 2, machines: 1},
          {period: '2014-01-22 13:00', running: 3, pending: 1, machines: 2},
          {period: '2014-01-22 14:00', running: 4, pending: 2, machines: 2},
          {period: '2014-01-22 15:00', running: 3, pending: 2, machines: 2},
          {period: '2014-01-22 16:00', running: 6, pending: 2, machines: 3},
          {period: '2014-01-22 17:00', running: 4, pending: 1, machines: 3},
          {period: '2014-01-22 18:00', running: 3, pending: 2, machines: 2},
          {period: '2014-01-22 19:00', running: 3, pending: 1, machines: 2},
          {period: '2014-01-22 20:00', running: 2, pending: 1, machines: 1},
          {period: '2014-01-22 21:00', running: 1, pending: 2, machines: 1},
          {period: '2014-01-22 22:00', running: 1, pending: 1, machines: 1},
          {period: '2014-01-22 23:00', running: 1, pending: 1, machines: 1}
        ],
        xkey: 'period',
        ykeys: ['running', 'pending', 'machines'],
        labels: ['Running', 'Pending', 'Machines'],
        pointSize: 2,
        hideHover: 'auto',
        resize: true
      });
    }
  </script>
</body>
</html>

