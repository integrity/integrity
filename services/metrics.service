[Unit]
Description=Metrics v04
After=docker.service
Requires=docker.service

[Service]
TimeoutStartSec=10min
Restart=always
ExecStartPre=-/usr/bin/docker kill metrics
ExecStartPre=-/usr/bin/docker rm metrics
ExecStartPre=/usr/bin/docker pull grnds/metrics:latest
ExecStart=/usr/bin/docker run --rm -e "METRICS_HOSTNAME=%H" -e "STATHAT_EZ_KEY=<%= ENV['STATHAT_EZ_KEY'] %>" --name metrics grnds/metrics:latest
ExecStop=/usr/bin/docker stop metrics
ExecStop=/usr/bin/docker rm metrics

[X-Fleet]
Global=true
MachineMetadata=role=worker
