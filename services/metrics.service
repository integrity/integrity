[Unit]
Description=Metrics v04
After=docker.service
Requires=docker.service

[Service]
Restart=always
ExecStart=/usr/bin/docker run --rm -e "STATHAT_EZ_KEY=<%= ENV['STATHAT_EZ_KEY'] %>" --name metrics grnds/metrics
ExecStop=/usr/bin/docker stop metrics

[X-Fleet]
Global=true
MachineMetadata=role=worker
