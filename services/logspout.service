[Unit]
Description=Logspout
After=docker.service
Requires=docker.service

[Service]
TimeoutStartSec=10min
Restart=always
ExecStartPre=-/usr/bin/docker kill logspout
ExecStartPre=-/usr/bin/docker rm logspout
ExecStartPre=/usr/bin/docker pull gliderlabs/logspout:latest
ExecStart=/usr/bin/docker run --rm -v=/var/run/docker.sock:/tmp/docker.sock --hostname="%H" --name=logspout gliderlabs/logspout:latest syslog://173.247.105.172:49166
ExecStop=/usr/bin/docker stop logspout
ExecStop=/usr/bin/docker rm logspout

[X-Fleet]
Global=true
