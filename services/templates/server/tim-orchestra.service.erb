[Unit]
Description=<%= stack_id %>_tim-orchestra
After=<%= stack_id %>_mysql.service
Requires=<%= stack_id %>_mysql.service

[Service]
Type=oneshot
RemainAfterExit=true
ExecStart=/usr/bin/docker run --rm -v /var/lib/docker/tmp:/tmp/hosttmp --name <%= stack_id %>_tim-orchestra --net=container:<%= stack_id %>_mysql \
-e "BRANCH=<%= tim_branch %>" \
-e "SHA=<%= tim_sha %>" \
-e "GITHUB_READ_TOKEN=<%= github_read_token %>" \
-e "AWS_ACCESS_KEY_ID=<%= aws_access_key_id %>" \
-e "AWS_SECRET_ACCESS_KEY=<%= aws_secret_access_key %>" \
-e "AWS_SECRET_KEY=<%= aws_secret_key %>" \
grnds/tim_ci \
/bin/bash -c 'git clone --branch <%= tim_branch %> https://<%= github_read_token %>@github.com/consultingmd/tim ./test_subject && \
./test_subject/dockyard-run orchestra from_github'
ExecStop=/usr/bin/docker rm -f <%= stack_id %>_tim-orchestra

[Install]
WantedBy=local.target

[X-Fleet]
MachineOf=<%= stack_id %>_mysql.service
