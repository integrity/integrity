[Unit]
Description=<%= stack_id %>_mailcatcher
After=<%= stack_id %>_mysql.service
Requires=<%= stack_id %>_mysql.service
BindsTo=<%= stack_id %>_mysql.service

[Service]
ExecStart=/usr/bin/docker run --rm -v /var/lib/docker/tmp:/tmp/hosttmp --name <%= stack_id %>_mailcatcher \
simpledrupalcloud/mailcatcher
ExecStop=/usr/bin/docker rm -f <%= stack_id %>_mailcatcher

[Install]
WantedBy=local.target

[X-Fleet]
MachineMetadata=role=worker
MachineOf=<%= stack_id %>_mysql.service
