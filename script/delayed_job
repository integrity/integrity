#!/usr/bin/env ruby

ENV['RAILS_ENV']    = 'development'
ENV['DATABASE_URL'] = ENV['INTEGRITY_DATABASE_URL']

require './init'
require 'integrity/builders/delayed_builder'
require 'delayed/command'

class Delayed::Command
  class Rails
    def self.root
      ROOT_DIR
    end
    def self.logger
      Integrity.logger
    end
  end
end

puts "#{ARGV.first}ing workers..."
Integrity.logger.info "#{ARGV.first}ing workers..."

begin
  Delayed::Command.new(ARGV).daemonize
rescue => e
  msg = "ERROR STARTING WORKERS:\n#{e.inspect}"
  puts  msg
  Integrity.logger.info msg
end

Delayed::Command.new(ARGV).daemonize
