#!/usr/bin/env ruby

ENV['RAILS_ENV'] = 'development'

require './init'
require 'integrity/builders/delayed_builder'
require 'delayed/command'

class Delayed::Command
  class Rails
    def self.root
      ROOT_DIR
    end
    def self.logger
      Integrity.logger
    end
  end
end

action  = "#{ARGV.first}ing"
message = "#{action} workers..."
Integrity.say message

begin
  Delayed::Command.new(ARGV).daemonize
rescue => e
  message = "ERROR: [#{action}]:\n#{e.inspect}"
  Integrity.say message
end

Delayed::Command.new(ARGV).daemonize
