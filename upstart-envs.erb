export APP_ROOT=/home/ubuntu/app/jarvis
export RUBYGEMSET=<%= ruby_gemset %>
export RUBYVERSION=<%= ruby_version %>
export PATH=/home/ubuntu/.rvm/gems/${RUBYVERSION}@${RUBYGEMSET}/bin:/home/ubuntu/.rvm/gems/${RUBYVERSION}@global/bin:/home/ubuntu/.rvm/rubies/${RUBYVERSION}/bin:/home/ubuntu/.rvm/bin:$PATH
export GEM_HOME=/home/ubuntu/.rvm/gems/${RUBYVERSION}@${RUBYGEMSET}
export GEM_PATH=/home/ubuntu/.rvm/gems/${RUBYVERSION}@${RUBYGEMSET}:/home/ubuntu/.rvm/gems/${RUBYVERSION}@global
export DATABASE_URL=${JARVIS_DATABASE_URL}
